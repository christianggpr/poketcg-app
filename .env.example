# Copia de referencia. Los valores reales van en Vercel → Settings → Environment Variables
# (y, para probar en una PC, en un archivo .env.local que nunca se sube al repositorio).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Clave secreta (service_role): solo en el servidor. Nunca en el navegador ni en el chat.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Resend → API Keys
RESEND_API_KEY=re_...

# Dominio y correos
NEXT_PUBLIC_APP_URL=https://poketcg.pe
EMAIL_FROM="PokéTCG <no-reply@poketcg.pe>"
ADMIN_EMAIL=info@poketcg.pe

# Tarea diaria y pg_cron (Fase 2): la misma clave va en Vercel y en supabase/programar-tareas.sql
CRON_SECRET=una-clave-larga-al-azar

# Fase 3 (opcional): clave propia para cifrar los datos de cobro de los vendedores (32+ caracteres al azar).
# Si no existe, se deriva de SUPABASE_SERVICE_ROLE_KEY. Si algún día la cambias, los datos guardados antes
# dejarán de poder leerse: los vendedores tendrían que registrarlos de nuevo.
# DATOS_COBRO_KEY=
