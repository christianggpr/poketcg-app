# Copia de referencia. Los valores reales van en Vercel → Settings → Environment Variables
# (y, para probar en una PC, en un archivo .env.local que nunca se sube al repositorio).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Clave secreta (service_role): solo en el servidor. Nunca en el navegador ni en el chat.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Resend → API Keys
RESEND_API_KEY=re_...

# Dominio y correos
NEXT_PUBLIC_APP_URL=https://poketcg.pe
EMAIL_FROM="PokéTCG <no-reply@poketcg.pe>"
ADMIN_EMAIL=info@poketcg.pe
